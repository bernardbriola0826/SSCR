# Copy this file to ".env" (in the server folder) and fill in real values.
# Never upload ".env" to GitHub. The school's IT staff keeps the real one.
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://ssc_user:CHANGE_ME@localhost:5432/ssc_db

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME

# OPTIONAL and NOT RECOMMENDED: lets anyone who knows a username sign in with no password.
# Only for a private school network that outsiders cannot reach. Never use it on a public
# link or with real student records. Leave this line commented out to keep passwords on.
# LOGIN_MODE=username-only
